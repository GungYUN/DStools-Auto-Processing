# =============================================================================
# ASKAP / DStools offline SIF build pins
#
# This file is sourced by prep_sources.sh, build_sif.sbatch, and the Apptainer
# %post script. Human-selected versions and package lists live here. Binary
# artefact hashes and the exact conda solve are written to BUILD_ROOT/manifests
# by prep_sources.sh and are verified again on the compute node.
# =============================================================================

# Replace placeholder paths before preparing or submitting a build.
BUILD_ROOT="/fred/YOUR_PROJECT/YOUR_OZSTAR_USER/dstools/sif-build-YYYYMMDD"

# OzSTAR login-node modules. The login node performs network downloads only;
# compilation of casacore/WSClean/python-casacore remains in the Slurm job.
HOST_GCC_MODULE="gcc/13.3.0"
HOST_PYTHON_MODULE="python/3.12.3"
HOST_APPTAINER_MODULE="apptainer"

# Existing project controller environment. Its astroquery/keyring versions are
# copied into the combined SIF lock instead of guessing new top-level versions.
CONTROLLER_PYTHON_BIN="/PATH/TO/askap-python/bin/python"

# Bootstrap image. This is the linux/amd64 manifest behind the official
# mambaorg/micromamba:1.4.6-jammy tag, pinned by immutable registry digest.
# The resulting SIF is additionally protected by manifests/base-sif.sha256.
BASE_IMAGE_REF="docker://mambaorg/micromamba@sha256:76480d46f8b9a0a13f602e240a6b86423906120a373315458f0b191387480b6e"
BASE_SIF_NAME="bootstrap.sif"

# C++ casacore.
CASACORE_GIT_URL="https://github.com/casacore/casacore.git"
CASACORE_TAG="v3.7.1"
CASACORE_EXPECTED_COMMIT="67b7d63dc333c5d4fce5d92f125c1e0ce0e3514a"

# python-casacore. It is built from this source tree, never from the wheel.
PYTHON_CASACORE_GIT_URL="https://github.com/casacore/python-casacore.git"
PYTHON_CASACORE_TAG="v3.7.1"
PYTHON_CASACORE_EXPECTED_COMMIT="4772a710ba7884c10a8dfb312e9fd4bae3513588"

# WSClean 3.5 is the version required by the selected DStools dev snapshot.
WSCLEAN_GIT_URL="https://gitlab.com/aroffringa/wsclean.git"
WSCLEAN_TAG="v3.5"
WSCLEAN_EXPECTED_COMMIT="7efb509246714def634e294b71a28d4fa35642fb"
WSCLEAN_PORTABLE="ON"

# Immutable casacore measures snapshot. This archive extracts ephemerides/ and
# geodetic/ directly, so the definition extracts it into .../data, not one level
# above that directory.
WSRT_MEASURES_URL="https://www.astron.nl/iers/WSRT_Measures_20260804-160001.ztar"
WSRT_MEASURES_FILENAME="casacore-measures.ztar"
WSRT_MEASURES_SHA256="1493c5a1e8c63d412ab6a353cfd2939e247075f6b0f34b2c95e710d366039f76"

# Python/conda bootstrap. The exact solve is captured in conda-explicit.txt.
PYTHON_VERSION="3.12"
NUMPY_VERSION="2.2.6"
CONDA_CHANNEL="conda-forge"
CONDA_BOOTSTRAP_SPECS=(
  "python=${PYTHON_VERSION}"
  "numpy=${NUMPY_VERSION}"
  "pip"
  "setuptools"
  "wheel"
  "libboost-python-devel"
  "conda-pack"
)

# Build backends required when pip build isolation is deliberately disabled.
PYTHON_BUILD_REQUIREMENTS=(
  "scikit-build-core>=0.8"
  "setuptools-scm"
  "poetry-core>=1.0.0"
)

# Ubuntu Jammy build dependencies. prep_sources.sh resolves and downloads the
# complete .deb closure inside the exact bootstrap SIF, then creates a file://
# APT repository. The compute-node build cannot contact Ubuntu mirrors.
APT_BUILD_PACKAGES=(
  build-essential
  cmake
  git
  pkg-config
  ca-certificates
  binutils
  ninja-build
  gfortran
  flex
  bison
  libblas-dev
  liblapack-dev
  liblapacke-dev
  libcfitsio-dev
  wcslib-dev
  libfftw3-dev
  libgsl-dev
  libhdf5-dev
  libboost-filesystem-dev
  libboost-program-options-dev
  libboost-system-dev
  libboost-date-time-dev
  libboost-test-dev
  libopenmpi-dev
  libncurses5-dev
  libreadline-dev
  libpython3-dev
)

# DStools source snapshot supplied by the user. It has no .git metadata, so the
# source tree is identified by file hashes rather than an invented commit.
DSTOOLS_LOCAL_SNAPSHOT="/PATH/TO/dstools-dev"
DSTOOLS_README_SHA256="a5a42c5bf9f2eecaa983dd6a4eb759e64c2d3a2496d2cff8c1902c2702f1c770"
DSTOOLS_PYPROJECT_SHA256="958da5c2995d5103b136b113fecec728c2f5033e6deb3a5f125cda5b48d73097"
DSTOOLS_POETRYLOCK_SHA256="724e18a5f5224fa802a68de3744b1bf37298fa525d1e518535c7f08b5b207479"
DSTOOLS_SOURCE_TREE_SHA256="b1b89f0d8a1abc558cc993be45b75c67d7e6660c1f23e8cad7b3ab7a81b1c51f"

# Both project patches are mandatory for this ASKAP build. Omitting either is a
# fatal preparation error; a partially patched scientific pipeline is forbidden.
DSTOOLS_PATCH_FILES=(
  "0001-visibility-weighting-unit.patch"
  "0002-unique-integrations.patch"
)

# Login-node-only Poetry export toolchain.
POETRY_PIN="poetry==1.8.3"
POETRY_EXPORT_PLUGIN_PIN="poetry-plugin-export==1.8.0"
