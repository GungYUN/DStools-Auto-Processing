+def test_parse_stdout_stderr_drains_stdout_after_stderr_eof(caplog):
+    logger = logging.getLogger(__name__)
+    setupLogger(verbose=True)
+    logger.addHandler(caplog.handler)
+
+    script = (
+        "import os, time; "
+        "os.close(2); "
+        "print('stdout before stderr EOF', flush=True); "
+        "time.sleep(0.1); "
+        "print('stdout after stderr EOF', flush=True)"
+    )
+    p = subprocess.Popen(
+        [sys.executable, "-c", script],
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+    )
+
+    returncode = parse_stdout_stderr(p, logger, print_stdout=False)
+
+    assert returncode == 0
+    assert "stdout before stderr EOF" in caplog.text
+    assert "stdout after stderr EOF" in caplog.text
+
+
+def test_parse_stdout_stderr_propagates_nonzero_exit(caplog):
+    logger = logging.getLogger(__name__)
+    setupLogger(verbose=True)
+    logger.addHandler(caplog.handler)
+
+    p = subprocess.Popen(
+        [
+            sys.executable,
+            "-c",
+            (
+                "import sys; "
+                "print('stdout before failure', flush=True); "
+                "print('stderr before failure', file=sys.stderr, flush=True); "
+                "raise SystemExit(7)"
+            ),
+        ],
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+    )
+
+    with pytest.raises(subprocess.CalledProcessError) as error:
+        parse_stdout_stderr(p, logger, print_stdout=False)
+
+    assert error.value.returncode == 7
+    assert "stdout before failure" in caplog.text
+    assert "stderr before failure" in caplog.text
+
